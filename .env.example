# ==============================================================================
# PerfPilot Environment Configuration
# ==============================================================================

# Application
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=sqlite+aiosqlite:///./perfpilot.db

# LiteLLM Configuration
LITELLM_MODEL=gpt-4o
LITELLM_FALLBACK_MODEL=claude-3-5-sonnet
MOCK_LLM=false
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# Provider Credentials (Optional for offline demo / deterministic test mode)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Sandbox and Verification Constraints
ARTIFACTS_DIR=./artifacts
MAX_BENCHMARK_DURATION_SEC=60
SANDBOX_TIMEOUT_SEC=120
MAX_VUS=100

# Authorized Target Hosts
ALLOWED_HOSTS=["localhost", "127.0.0.1", "demo-app"]
